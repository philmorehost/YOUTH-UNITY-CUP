{"version": "0.4", "title": "YUC Where to Watch", "type": "page", "content": [{"id": "6634742", "elType": "section", "settings": {"css_classes": "phero", "layout": "full_width", "content_width": {"unit": "px", "size": 1180}}, "elements": [{"id": "8c3dd46", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null}, "elements": [{"id": "0cd5666", "elType": "widget", "widgetType": "heading", "settings": {"title": "Where to watch", "header_size": "h1"}, "elements": []}, {"id": "47b5aa6", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Every match is free to attend, and we are bringing it to your screen and radio too.</p>"}, "elements": []}]}], "isInner": false}, {"id": "a62f301", "elType": "section", "settings": {"css_classes": "", "layout": "boxed", "content_width": {"unit": "px", "size": 1180}}, "elements": [{"id": "f465365", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null}, "elements": [{"id": "c036bb3", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<div class=\"g3\"><div class=\"yuc-card\" style=\"padding:20px\"><h3>At the venue</h3><p>Ten zonal venues, free entry, 700 spectators per venue.</p></div><div class=\"yuc-card\" style=\"padding:20px\"><h3>On the radio</h3><p>Match coverage on Isokan FM.</p></div><div class=\"yuc-card\" style=\"padding:20px\"><h3>Online</h3><p>Live scores and highlights on our social channels. Links will appear here.</p></div></div>"}, "elements": []}]}], "isInner": false}], "page_settings": {"hide_title": "yes"}}