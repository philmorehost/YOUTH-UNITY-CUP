{"version": "0.4", "title": "YUC About", "type": "page", "content": [{"id": "60caea6", "elType": "section", "settings": {"css_classes": "phero", "layout": "full_width", "content_width": {"unit": "px", "size": 1180}}, "elements": [{"id": "3367c29", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null}, "elements": [{"id": "1578b5c", "elType": "widget", "widgetType": "heading", "settings": {"title": "About the Youth Unity Cup", "header_size": "h1"}, "elements": []}, {"id": "72dc4ee", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>A community-owned football platform that tests, verifies and prepares LGAs for lasting infrastructure.</p>"}, "elements": []}]}], "isInner": false}, {"id": "d15a4f4", "elType": "section", "settings": {"css_classes": "", "layout": "boxed", "content_width": {"unit": "px", "size": 1180}}, "elements": [{"id": "ef27e95", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null}, "elements": [{"id": "a80b21e", "elType": "widget", "widgetType": "heading", "settings": {"title": "Why we exist", "header_size": "h2", "_css_classes": "yuc-section-title"}, "elements": []}, {"id": "ad8f062", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Grassroots football can bring a community together, support small businesses, give young people structured work and keep venues safe. The cup is built around those five goals, and Mushin LGA is the pilot.</p>"}, "elements": []}]}], "isInner": false}, {"id": "1c3f252", "elType": "section", "settings": {"css_classes": "", "layout": "boxed", "content_width": {"unit": "px", "size": 1180}}, "elements": [{"id": "edc87ff", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null}, "elements": [{"id": "89c6948", "elType": "widget", "widgetType": "heading", "settings": {"title": "How it works", "header_size": "h2", "_css_classes": "yuc-section-title"}, "elements": []}, {"id": "f6d30c0", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<div class=\"g3\"><div class=\"yuc-card\" style=\"padding:20px\"><h3>1. Compete</h3><p>20 teams from ten zones play a safe, free, verified competition.</p></div><div class=\"yuc-card\" style=\"padding:20px\"><h3>2. Score</h3><p>Each community is scored on a 100-point viability test.</p></div><div class=\"yuc-card\" style=\"padding:20px\"><h3>3. Build</h3><p>Strong scores unlock a 500-seat pavilion, then a stadium for repeat top performers.</p></div></div>"}, "elements": []}]}], "isInner": false}, {"id": "4709ab7", "elType": "section", "settings": {"css_classes": "", "layout": "boxed", "content_width": {"unit": "px", "size": 1180}}, "elements": [{"id": "f3f386d", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null}, "elements": [{"id": "4adfa36", "elType": "widget", "widgetType": "heading", "settings": {"title": "Who is behind it", "header_size": "h2", "_css_classes": "yuc-section-title"}, "elements": []}, {"id": "d084016", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Hosted by the NYCN, the Mushin CDC and 55 CDAs. Piloted with the South West Development Commission. Technical Secretariat: Best Trade Fulcrum / Foreway Sports and Urban Wear.</p>"}, "elements": []}]}], "isInner": false}], "page_settings": {"hide_title": "yes"}}