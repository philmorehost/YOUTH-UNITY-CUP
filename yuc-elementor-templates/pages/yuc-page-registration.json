{"version": "0.4", "title": "YUC Registration", "type": "page", "content": [{"id": "d268a29", "elType": "section", "settings": {"css_classes": "phero", "layout": "full_width", "content_width": {"unit": "px", "size": 1180}}, "elements": [{"id": "a0d3473", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null}, "elements": [{"id": "3c39c20", "elType": "widget", "widgetType": "heading", "settings": {"title": "Register for the Youth Unity Cup", "header_size": "h1"}, "elements": []}, {"id": "0661fcc", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Players, vendors, CDA representatives and NYCN delegates all register here with a live photo.</p>"}, "elements": []}]}], "isInner": false}, {"id": "6089065", "elType": "section", "settings": {"css_classes": "", "layout": "boxed", "content_width": {"unit": "px", "size": 1180}}, "elements": [{"id": "c3146e8", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null}, "elements": [{"id": "01ef56e", "elType": "widget", "widgetType": "heading", "settings": {"title": "Before you start", "header_size": "h2", "_css_classes": "yuc-section-title"}, "elements": []}, {"id": "64dc3cd", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<ul class=\"yuc-list\"><li>Players: ID type (NIN, LASRRA, or birth certificate with parent PVC) and the last 4 digits only.</li><li>A parent or guardian must consent for anyone under 18.</li><li>You need a device with a camera. Allow camera access when asked.</li><li>Players must be under 19.</li></ul>"}, "elements": []}]}], "isInner": false}, {"id": "f4c5497", "elType": "section", "settings": {"css_classes": "", "layout": "boxed", "content_width": {"unit": "px", "size": 1180}}, "elements": [{"id": "7656cf2", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null}, "elements": [{"id": "0a9c222", "elType": "widget", "widgetType": "heading", "settings": {"title": "Register", "header_size": "h2", "_css_classes": "yuc-section-title"}, "elements": []}, {"id": "670bbe4", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"yuc-reg\" id=\"register\">\n<div class=\"yuc-tabs\" id=\"yt\"></div>\n<form class=\"yuc-form\" id=\"yf\" onsubmit=\"return false\">\n<div><div class=\"yuc-cam\" id=\"yc\"><span>NO PHOTO<br>CAPTURE LIVE</span></div><button type=\"button\" class=\"yuc-snap\" id=\"ys\">Take live photo</button></div>\n<div><div class=\"yuc-fields\" id=\"yfl\"></div>\n<label style=\"display:flex;gap:8px;margin-top:14px;font-size:12px\"><input type=\"checkbox\" id=\"yk\"> I confirm the details are true and, for anyone under 18, that a parent/guardian consents to registration and photo capture.</label>\n<button type=\"button\" class=\"yuc-go\" id=\"yg\" style=\"margin-top:14px\">Register &amp; generate ID</button><div class=\"yuc-msg\" id=\"ym\"></div></div></form>\n<div id=\"yid\"></div></div>\n<script>\n(function(){\nvar Z=['Alaafia','Atewolara','Idi-Oro','Papa Ajao','Ladipo','Ilasamaja','Itire','Ijesha','Olorunsogo','Idi-Araba'];\nvar T={Player:[['name','Full name',1],['dob','Date of birth',1,'date'],['idt','ID type',1,['NIN','LASRRA','Birth certificate + parent PVC']],['id4','ID last 4 digits',1],['zone','Zone',1,Z],['school','School',0],['team','Team name',1],['phone','Parent / guardian phone',1]],\nVendor:[['name','Full name',1],['biz','Business name',1],['stall','Stall type',1,['Food','Drinks','Snacks','Merchandise','Other']],['zone','Zone',1,Z],['cda','CDA',1],['phone','Phone',1]],\n'CDA Rep':[['name','Full name',1],['cda','CDA',1],['pos','Position',1],['zone','Zone',1,Z],['phone','Phone',1]],\nNYCN:[['name','Full name',1],['pos','NYCN role',1],['zone','Zone',1,Z],['phone','Phone',1]]};\nvar role='Player',photo=null,st=null,n=100,$=function(i){return document.getElementById(i)};\nfunction stop(){if(st){st.getTracks().forEach(function(t){t.stop()});st=null}}\nfunction draw(){$('yt').innerHTML=Object.keys(T).map(function(r){return '<button type=\"button\" class=\"'+(r==role?'on':'')+'\" data-r=\"'+r+'\">'+r+'</button>'}).join('');\n$('yfl').innerHTML=T[role].map(function(f){var c=f[3];var i=Array.isArray(c)?'<select name=\"'+f[0]+'\">'+c.map(function(o){return '<option>'+o+'</option>'}).join('')+'</select>':'<input name=\"'+f[0]+'\" type=\"'+(c||'text')+'\"'+(f[0]=='id4'?' maxlength=\"4\" inputmode=\"numeric\"':'')+'>';return '<label>'+f[1]+(f[2]?' *':'')+i+'</label>'}).join('');photo=null;stop();$('yc').innerHTML='<span>NO PHOTO<br>CAPTURE LIVE</span>';$('ys').textContent='Take live photo'}\n$('yt').onclick=function(e){if(e.target.dataset.r){role=e.target.dataset.r;draw()}};\n$('ys').onclick=function(){var c=$('yc');\nif(st){var v=c.querySelector('video'),k=document.createElement('canvas'),w=Math.min(480,v.videoWidth);k.width=w;k.height=w*v.videoHeight/v.videoWidth;k.getContext('2d').drawImage(v,0,0,k.width,k.height);photo=k.toDataURL('image/jpeg',.82);stop();c.innerHTML='<img src=\"'+photo+'\" alt=\"Captured\">';$('ys').textContent='Retake photo';return}\nnavigator.mediaDevices&&navigator.mediaDevices.getUserMedia({video:{facingMode:'user',width:{ideal:640}}}).then(function(s){st=s;c.innerHTML='<video playsinline muted></video><div class=\"ring\"></div>';var v=c.querySelector('video');v.srcObject=s;v.play();$('ys').textContent='Capture'}).catch(function(){$('ym').textContent='Camera unavailable. Allow camera access (HTTPS required) and try again.'})};\n$('yg').onclick=function(){var f=$('yf'),d={},bad=0;T[role].forEach(function(x){var el=f.elements[x[0]];d[x[0]]=el.value.trim();if(x[2]&&!d[x[0]])bad=1});\nvar m=$('ym');m.textContent='';\nif(bad)return m.textContent='Please complete all fields marked *.';\nif(!photo)return m.textContent='A live photo is required.';\nif(!$('yk').checked)return m.textContent='Please tick the confirmation box.';\nif(role=='Player'){var b=new Date(d.dob),a=new Date(Date.now()-b.getTime()).getUTCFullYear()-1970;if(!(a<19))return m.textContent='Players must be under 19 (see Rules & Regulations).';if(!/^\\d{4}$/.test(d.id4))return m.textContent='Enter the last 4 digits of the ID only.'}\nn++;var no='YUC-2026-'+String(n).padStart(4,'0');\n$('yid').innerHTML='<div class=\"yuc-id\"><img src=\"'+photo+'\" alt=\"\"><div><small>YOUTH UNITY CUP \u00b7 MUSHIN</small><b></b><small>'+role.toUpperCase()+' \u00b7 '+(d.zone||'')+'</small><small style=\"color:#fff\">'+no+'</small></div></div>';$('yid').querySelector('b').textContent=d.name;\n/* To save: POST {role,data:d,photo} to your endpoint, e.g. fetch(YUC_ENDPOINT,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({role:role,data:d,photo:photo})}) */\n};draw()})();\n</script>"}, "elements": []}]}], "isInner": false}], "page_settings": {"hide_title": "yes"}}