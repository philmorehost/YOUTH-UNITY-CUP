{"version": "0.4", "title": "YUC Rules & Regulations", "type": "page", "content": [{"id": "d0f0cc0", "elType": "section", "settings": {"css_classes": "phero", "layout": "full_width", "content_width": {"unit": "px", "size": 1180}}, "elements": [{"id": "22238da", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null}, "elements": [{"id": "9a422eb", "elType": "widget", "widgetType": "heading", "settings": {"title": "Rules & Regulations", "header_size": "h1"}, "elements": []}, {"id": "14ab2f2", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>A summary of the rules. Full regulations will be published before the draw.</p>"}, "elements": []}]}], "isInner": false}, {"id": "80b9465", "elType": "section", "settings": {"css_classes": "", "layout": "boxed", "content_width": {"unit": "px", "size": 1180}}, "elements": [{"id": "aef7ac8", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null}, "elements": [{"id": "ceee209", "elType": "widget", "widgetType": "heading", "settings": {"title": "Eligibility", "header_size": "h2", "_css_classes": "yuc-section-title"}, "elements": []}, {"id": "2f073ff", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<ul class=\"yuc-list\"><li>Players must be under 19 and verified with a live photo and approved ID.</li><li>Each squad has up to 18 players and 3 team officials.</li><li>Players complete pre-competition health screening.</li></ul>"}, "elements": []}]}], "isInner": false}, {"id": "853ef86", "elType": "section", "settings": {"css_classes": "", "layout": "boxed", "content_width": {"unit": "px", "size": 1180}}, "elements": [{"id": "dcfaea2", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null}, "elements": [{"id": "6d66c7a", "elType": "widget", "widgetType": "heading", "settings": {"title": "Format", "header_size": "h2", "_css_classes": "yuc-section-title"}, "elements": []}, {"id": "644fb12", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<ul class=\"yuc-list\"><li>20 teams in 5 groups of 4, round-robin, 30 group matches.</li><li>Quarter-finals: 5 group winners and the 3 best runners-up.</li><li>Then semi-finals, a 3rd place match and the Final.</li></ul>"}, "elements": []}]}], "isInner": false}, {"id": "413e3b2", "elType": "section", "settings": {"css_classes": "", "layout": "boxed", "content_width": {"unit": "px", "size": 1180}}, "elements": [{"id": "66f850f", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null}, "elements": [{"id": "1818b90", "elType": "widget", "widgetType": "heading", "settings": {"title": "Match days and spectators", "header_size": "h2", "_css_classes": "yuc-section-title"}, "elements": []}, {"id": "4ce6087", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<ul class=\"yuc-list\"><li>Matches are played on Saturdays and Sundays across 8 weekends.</li><li>Entry is free. Each venue is capped at 700 spectators.</li><li>No cash is handled by community leadership; all payments go through the audited account.</li></ul>"}, "elements": []}]}], "isInner": false}], "page_settings": {"hide_title": "yes"}}