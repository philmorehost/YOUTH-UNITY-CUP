{"version": "0.4", "title": "YUC Learning", "type": "page", "content": [{"id": "47f2866", "elType": "section", "settings": {"css_classes": "phero", "layout": "full_width", "content_width": {"unit": "px", "size": 1180}}, "elements": [{"id": "028de71", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null}, "elements": [{"id": "d133187", "elType": "widget", "widgetType": "heading", "settings": {"title": "Beyond the pitch", "header_size": "h1"}, "elements": []}, {"id": "c8df952", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>The cup is also a classroom for health, safety and youth skills.</p>"}, "elements": []}]}], "isInner": false}, {"id": "4ea410f", "elType": "section", "settings": {"css_classes": "", "layout": "boxed", "content_width": {"unit": "px", "size": 1180}}, "elements": [{"id": "b9102f2", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null}, "elements": [{"id": "159b42b", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<div class=\"g3\"><div class=\"yuc-card\" style=\"padding:20px\"><h3>Health talks</h3><p>A 10-minute talk before every match: drug abuse, sickle cell, genotype awareness, malaria and open defecation.</p></div><div class=\"yuc-card\" style=\"padding:20px\"><h3>Youth sessions</h3><p>NYCN-led discussions on drug abuse, internet fraud, education and mental health.</p></div><div class=\"yuc-card\" style=\"padding:20px\"><h3>Media skills</h3><p>Five-day training for our 55 youth influencers on content, safety and storytelling.</p></div></div>"}, "elements": []}]}], "isInner": false}], "page_settings": {"hide_title": "yes"}}